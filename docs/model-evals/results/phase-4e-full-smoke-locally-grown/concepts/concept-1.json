  "presentation": {
    "name": "Cultivated Welcome",
    "description": "A calm, tended welcome that gently unfolds from first growth into flourishing promise."
  },
  "premise": {
    "title": "Cultivated Welcome",
    "register": {
      "pace": "lingering",
      "presence": "understated",
      "surfaceRichness": "considered"
    },
    "grounding": [
      "Gardens, growing and cultivation are central to the locally grown idea.",
      "The growing idea should carry the welcome rather than merely decorate it.",
      "Typography should carry warmth and craft rather than novelty.",
      "The host requires the result to be neither childish nor cheesy."
    ],
    "experience": "Guests should feel gently drawn into a warm, composed celebration that becomes more expressive as they move through it, while remaining grown-up and unfussy.",
    "foregrounds": "The cultivation side of the locally grown idea: growth as an unfolding process rather than a finished decorative theme.",
    "distinctFrom": "This offers a quieter, more contemplative emphasis on growth and becoming, rather than the brisk freshness of market culture or the immersive fullness of harvest abundance.",
    "organizingIdea": "Let the celebration unfold through a sense of cultivation, moving from emerging growth toward flourishing promise. The baby shower welcome feels intentionally tended, with becoming at its heart.",
    "designConsequences": [
      "A restrained sense of progression from emerging growth to flourishing life",
      "Organic character that feels observed and cultivated rather than cartooned",
      "Tactile, made qualities handled with calm restraint",
      "Mature charm without sweetness or novelty"
    ]
  },
