  "presentation": {
    "name": "Gathered Abundance",
    "description": "Harvest warmth, tactile depth and confident plenty create a richly gathered welcome that feels polished, never rustic."
  },
  "premise": {
    "title": "Gathered Abundance",
    "register": {
      "pace": "measured",
      "presence": "commanding",
      "surfaceRichness": "layered"
    },
    "grounding": [
      "Harvest and abundance are central to the creative direction.",
      "The palette intent calls for restraint so the result reads composed rather than busy.",
      "Natural, tactile and organic surfaces should have a made quality while remaining restrained.",
      "The event should feel elevated rather than like rustic pastiche."
    ],
    "experience": "Guests should feel surrounded by a generous, celebratory sense of plenty that is tactile and organic yet still polished and easy to take in.",
    "foregrounds": "Harvest and abundance as expressions of generosity, celebration and a richly gathered welcome.",
    "distinctFrom": "This delivers the fullest and most immersive celebration, choosing generous richness over quiet emergence or brisk market-day movement.",
    "organizingIdea": "Frame the shower as a gathered harvest, allowing fullness and generosity to make the coming arrival feel richly celebrated. Abundance is disciplined into a confident whole rather than allowed to become rustic or busy.",
    "designConsequences": [
      "A full and generous character without visual clutter",
      "Produce and garden cues gathered into a composed sense of plenty",
      "Layered tactile qualities that evoke harvest richness",
      "Confident celebration that remains elevated rather than cute"
    ]
  },
