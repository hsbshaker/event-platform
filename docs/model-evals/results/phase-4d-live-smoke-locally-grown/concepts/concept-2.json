  "premise": {
    "title": "Market Welcome",
    "register": {
      "pace": "propulsive",
      "presence": "poised",
      "surfaceRichness": "layered"
    },
    "grounding": [
      "The creative direction includes the character of a good local market.",
      "Motif ideas include local market and stall culture.",
      "The tonal intent evokes the bright, clean daylight of a morning market.",
      "The feeling should be warm, fresh and celebratory."
    ],
    "experience": "Arriving should feel bright, lively and inviting, with the pleasurable sense of encountering a fresh and thoughtfully assembled celebration.",
    "foregrounds": "The freshness, character and sociable visual energy of a good local market, interpreted in a composed and unmistakably celebratory way.",
    "distinctFrom": "This gives the occasion more momentum and outward-facing energy than the quieter cultivation idea or the richer, more settled expression of abundance.",
    "organizingIdea": "The site welcomes guests with the immediacy of a beautifully presented market: fresh, generous and full of distinct points of interest. Its charm comes from confident arrangement and produce-led character rather than whimsy.",
    "designConsequences": [
      "A lively rhythm with a sense of discovery",
      "Produce and stall culture treated with polish and restraint",
      "Variety held together by clear composure",
      "Freshness conveyed without nursery sweetness"
    ]
