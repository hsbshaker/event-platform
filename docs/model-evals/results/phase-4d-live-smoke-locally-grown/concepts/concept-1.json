  "presentation": {
    "name": "Tended Welcome",
    "description": "A calm, cultivated welcome that unfolds with quiet warmth, thoughtful care and purposeful garden character."
  },
  "premise": {
    "title": "Tended Welcome",
    "register": {
      "pace": "lingering",
      "presence": "poised",
      "surfaceRichness": "considered"
    },
    "grounding": [
      "The growing idea should carry the welcome rather than decorate it.",
      "Motif ideas include growing and cultivation.",
      "The locally grown idea can organise the whole page.",
      "The result should be charming rather than sweet and elevated rather than rustic pastiche."
    ],
    "experience": "Arriving should feel calm, warm and expectant, as though guests are being welcomed into a celebration that has been carefully tended.",
    "foregrounds": "Growing and cultivation as the welcome, with the baby shower understood through careful tending rather than applied garden decoration.",
    "distinctFrom": "This offers a more reflective and gently unfolding experience than either the liveliness of a local market or the fullness of a gathered harvest.",
    "organizingIdea": "The celebration unfolds like something thoughtfully cultivated, allowing growth to shape the guest’s sense of anticipation and care. Produce and garden character feel integral because they belong to that progression.",
    "designConsequences": [
      "A sense of gradual unfolding and cultivated rhythm",
      "Garden and produce character used with purpose rather than novelty",
      "Natural tactility balanced by grown-up restraint",
      "Charm expressed through care and composure"
    ]
  },
