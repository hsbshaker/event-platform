  "presentation": {
    "name": "Ripe Radiance",
    "description": "Sunlit lemons punctuate the garden with a polished, convivial energy that feels vivid, grown-up, and warmly inviting."
  },
  "premise": {
    "title": "Ripe Radiance",
    "register": {
      "pace": "propulsive",
      "presence": "poised",
      "surfaceRichness": "considered"
    },
    "grounding": [
      "Ripe lemons with leaves",
      "Keep lemons recognizable and richly drawn",
      "The atmosphere should feel intimate and celebratory",
      "Warm, gracious, and convivial, with polished simplicity rather than precious baby-themed language"
    ],
    "experience": "Guests should feel an immediate lift of warmth and sociability—polished but cheerful, vivid without becoming juvenile.",
    "foregrounds": "Recognizable ripe lemons as the most convivial and celebratory expression of the garden.",
    "distinctFrom": "It gives the event its most animated expression, favoring recognizable botanical character and convivial momentum over immersive enclosure or the quieter authority of age and pattern.",
    "organizingIdea": "Ripeness becomes the pulse: fruit and leaves recur as concentrated moments of sunlit abundance, turning cultivated botanical detail into a lively invitation to gather.",
    "designConsequences": [
      "Ripe fruit and leaves carry confident, carefully crafted detail.",
      "Botanical moments arrive in a lively, selective cadence rather than as blanket decoration.",
      "Refinement comes from composition and restraint while warmth remains unmistakable.",
      "The character stays elegant and adult, never cartoonish."
    ]
  },
