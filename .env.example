# Copy to .env.local for local development. Never commit real values.

# Supabase (docs/technology-decisions.md §4). Local defaults come from `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the app (OAuth redirects, share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ byte secret for hashing pre-auth draft tokens and encrypting private event codes.
# Generate: openssl rand -base64 48
APP_ENCRYPTION_KEY=

# Integration tests (npm run test:db) — a Postgres 16 superuser connection.
# The suite installs an `auth` schema stub and runs supabase/migrations against it.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# OAuth providers configured in the Supabase project, comma separated (google, apple).
# Only the ones listed here are offered on the sign-in screen.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Authorizes the scheduled pre-auth cleanup at /api/cron/purge-pre-auth. Vercel sends it as
# `Authorization: Bearer <value>`; the route is 404 without it. Generate: openssl rand -hex 32
CRON_SECRET=

# Routes a Human Test #1 submission to the synthetic table so the deployed survey flow can be
# verified without contaminating the five real reviewer responses. Unset means every submission
# is a real one. Generate: openssl rand -hex 32
HUMAN_TEST_1_TEST_SECRET=

# Phase 4A — OpenAI, the approved production provider for the Event Identity call
# (docs/model-contracts.md §4, docs/technology-decisions.md §8). Server-only: never expose
# this through a NEXT_PUBLIC_* variable or browser code. Validated lazily, so every code path
# that does not call a model runs without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# low | medium | high. Defaults to high: Phase 4A establishes the creative ceiling first and
# measures latency honestly against spec.md §7.10 rather than trading quality to hit it.
OPENAI_REASONING_EFFORT=high

# Phase 4B T9A — EventIdentity call-level spend controls (docs/phase-4b-plan.md §A.5, §A.5.1).
# Every one of these is optional and has a safe default; they are listed because two of them
# govern money and MUST be set from current provider documentation before deployment.
#
# A conservative upper bound, in USD, on what ONE provider attempt can bill: the model's maximum
# billable input + output + reasoning usage at its published prices. The shipped default is an
# explicitly UNVERIFIED placeholder. A logical call may make six attempts, so the reservation each
# in-flight call holds against the ceiling is six times this.
# IDENTITY_PROVIDER_ATTEMPT_MAX_USD=5
#
# Published per-million-token prices, as JSON. Unset means observed usage cannot be priced, so
# every attempt is costed at the maximum above — a real ceiling, just a blunt one. Setting this
# makes the accounting exact wherever the provider reported usage.
# IDENTITY_TOKEN_PRICES_USD_PER_MTOK={"input":0,"cachedInput":0,"output":0}
#
# Backend safety limits (spec.md §10). Never surfaced to a host: every refusal returns one
# indistinguishable payload, because a distinguishable one is a spend counter with extra steps
# (spec.md §32 #41).
# IDENTITY_EVENT_DAILY_MAX=20
# IDENTITY_ACCOUNT_DAILY_MAX=40
# IDENTITY_ACCOUNT_RATE_MAX=6
# IDENTITY_ACCOUNT_RATE_WINDOW_SECONDS=60
# IDENTITY_CEILING_USD=3000
# IDENTITY_CEILING_WINDOW_SECONDS=86400
# IDENTITY_CEILING_WARN_FRACTION=0.8
#
# How long a claim may hold its slot. Refused below the boundary's own bounded worst case
# (attempts x timeout + backoffs), because a lease shorter than a legitimate call expires a live
# one and turns the host's retry into a second concurrent paid call.
# IDENTITY_CLAIM_LEASE_SECONDS=844

# Phase 4+: Twilio, Stripe. Added with their phases; not read yet.
